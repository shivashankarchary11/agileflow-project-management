# Copy to .env (never commit .env) and export the variables, or set them in your shell.
# Every variable is optional in development; SECRET_KEY is REQUIRED when APP_ENV=production.

# development | testing | production
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Default: sqlite:///agileflow.db (stored in instance/)
# DATABASE_URL=sqlite:///agileflow.db

# Set to 0 to allow login over plain http (local Docker demo). Keep 1 behind HTTPS.
# COOKIE_SECURE=1

# --- Registration policy ---
# 1 = people choose Team Lead/Member/Viewer when signing up (demo friendly; default in development)
# 0 = first account becomes Team Lead, everyone else is a Member (default in production)
# ALLOW_SELF_SELECT_ROLE=1

# --- Background worker ---
# WORKER_ENABLED=1
# WORKER_POLL_SECONDS=1
# JOB_MAX_ATTEMPTS=3
# JOB_BACKOFF_BASE_SECONDS=2      # retry delay = base * 2^attempt
# JOB_STALE_SECONDS=300           # a Running job older than this is re-queued

# --- Email ---
# console = print emails to the log (default, needs no setup)
# smtp    = send for real (fill in the SMTP_* values)
MAIL_BACKEND=console
MAIL_FROM=AgileFlow <no-reply@agileflow.local>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1

# --- Server ---
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0
